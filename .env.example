# ── Domains ───────────────────────────────────────────────────────────────────
# Change these to your real domains before deploying
API_DOMAIN=api.domain.com
ADMIN_DOMAIN=admin.domain.com

# ── Ports (host machine — Nginx proxies to these) ─────────────────────────────
# Change only if these ports are already in use on your server
API_PORT=8000
ADMIN_PORT=7000

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=nextadmin
DB_USER=nextadmin
DB_PASSWORD=change-this-strong-password

# ── Security (generate with: openssl rand -hex 32) ────────────────────────────
SECRET_KEY=generate-32-char-random-string
JWT_SECRET=generate-another-32-char-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ── Request Logs ──────────────────────────────────────────────────────────────
# The admin "Request Logs" viewer tails the nginx access log (configured by
# setup-nginx.sh, written to ./data/logs/access.log) and keeps the newest
# REQUEST_LOG_MAX_LINES enriched entries; older ones are wiped.
REQUEST_LOG_MAX_LINES=100000
# Override only if your nginx access log is mounted at a non-default path:
# NGINX_ACCESS_LOG=/app/logs/access.log

# ── Email ─────────────────────────────────────────────────────────────────────
# For Gmail: enable 2FA and use an App Password (not your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@domain.com
